{
  "name": "@aphrody/scaffold",
  "version": "1.4.4",
  "description": "The single Bun-native project scaffolder of the M3 UI stack and its web/app templates.",
  "keywords": [
    "material-3",
    "scaffold",
    "bun-native",
    "template"
  ],
  "license": "Apache-2.0",
  "author": "aphrody-code",
  "bin": {
    "aphrody-scaffold": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pins": "./src/pins.ts",
    "./png": "./src/png.ts",
    "./names": "./src/names.ts",
    "./files": "./src/files.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "bun check -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@aphrody/web-source": "workspace:*"
  },
  "devDependencies": {
    "@aphrody/m3-config": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
